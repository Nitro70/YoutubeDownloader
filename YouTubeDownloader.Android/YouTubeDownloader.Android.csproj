<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Without this a net8.0-android project builds as a class library (a
         .dll, no APK). Exe marks it as an Android application. -->
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-android</TargetFramework>
    <SupportedOSPlatformVersion>21</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <!-- Build under the .NET 8 SDK (see CI's global.json). A newer SDK flags
         net8.0-android as EOL; this keeps that a warning rather than an error. -->
    <CheckEolTargetFramework>false</CheckEolTargetFramework>

    <!-- Assembly name gives the avares:// URIs their prefix; the CLR namespace
         is deliberately ".Droid" so unqualified `Android.*` platform types
         don't collide with a namespace ending in ".Android". -->
    <AssemblyName>YouTubeDownloader.Android</AssemblyName>
    <RootNamespace>YouTubeDownloader.Droid</RootNamespace>

    <ApplicationId>com.nitro70.youtubedownloader</ApplicationId>
    <ApplicationVersion>4</ApplicationVersion>
    <ApplicationDisplayVersion>3.4.1</ApplicationDisplayVersion>

    <!-- Emit an installable .apk (Release would otherwise produce an .aab). -->
    <AndroidPackageFormat>apk</AndroidPackageFormat>

    <!-- Trimming and AOT stay off. The ILLink IL1032 error that first prompted this was
         the doubled Avalonia path fixed at the bottom of this file, but a trimmed Avalonia
         build has never been tried on a device, and a larger APK is fine for sideloading. -->
    <AndroidLinkMode>None</AndroidLinkMode>
    <PublishTrimmed>false</PublishTrimmed>
    <RunAOTCompilation>false</RunAOTCompilation>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.2.3" />
    <PackageReference Include="Avalonia.Android" Version="11.2.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.3" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.2.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\YouTubeDownloader.Core\YouTubeDownloader.Core.csproj" />
  </ItemGroup>

  <!-- Avalonia compiles the XAML into a copy of the app assembly under obj\...\Avalonia\ and points
       @(IntermediateAssembly) at that copy. The Android SDK's per-ABI inner builds are handed the
       outer build's already-redirected path (_OuterIntermediateAssembly), and Avalonia redirects it
       a second time, to obj\...\Avalonia\Avalonia\, which does not exist. The packager then leaves
       the app's own assembly, and with it the launcher activity, out of the APK. Undo the second
       redirect in those inner builds. -->
  <Target Name="KeepOuterAvaloniaAssemblyInInnerBuilds"
          AfterTargets="InjectAvaloniaXamlOutput"
          Condition="'$(_OuterIntermediateAssembly)' != ''">
    <ItemGroup>
      <IntermediateAssembly Remove="@(IntermediateAssembly)" />
      <IntermediateAssembly Include="$(_OuterIntermediateAssembly)" />
    </ItemGroup>
    <ItemGroup Condition="'@(_DebugSymbolsIntermediatePath)' != ''">
      <_DebugSymbolsIntermediatePath Remove="@(_DebugSymbolsIntermediatePath)" />
      <_DebugSymbolsIntermediatePath Include="$([System.IO.Path]::ChangeExtension('$(_OuterIntermediateAssembly)', '.pdb'))" />
    </ItemGroup>
  </Target>

</Project>

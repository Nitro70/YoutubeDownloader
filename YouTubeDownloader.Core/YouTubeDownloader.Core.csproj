<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>YouTubeDownloader.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Pure-managed YouTube extraction. No subprocess, no ffmpeg, so it
         runs on iOS where Process.Start is forbidden. -->
    <PackageReference Include="YoutubeExplode" Version="6.6.2" />
  </ItemGroup>

</Project>

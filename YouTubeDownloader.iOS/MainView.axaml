<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="using:YouTubeDownloader.Core"
             x:Class="YouTubeDownloader.iOS.MainView"
             Background="{DynamicResource BgDarkBrush}">

    <ScrollViewer>
        <StackPanel Margin="16,50,16,24" Spacing="0">

            <!-- Header -->
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,16">
                <TextBlock Text="▶" FontSize="26" FontWeight="Bold"
                           Foreground="{DynamicResource RedBrush}"
                           VerticalAlignment="Center"/>
                <TextBlock Text="YouTube Downloader" Classes="header"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <!-- URL card -->
            <Border Classes="card">
                <StackPanel Spacing="12">
                    <TextBlock Text="Video link or search" Classes="label"/>
                    <Panel>
                        <TextBox Name="UrlTextBox" Classes="yt"
                                 TextChanged="UrlTextBox_TextChanged"
                                 KeyDown="UrlTextBox_KeyDown"/>
                        <TextBlock Name="UrlPlaceholder"
                                   Text="Paste a link or type to search…"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   VerticalAlignment="Center"
                                   Margin="15,0,0,0"
                                   IsHitTestVisible="False"/>
                    </Panel>
                    <Grid ColumnDefinitions="*,12,*">
                        <Button Name="PasteButton" Grid.Column="0"
                                Content="📋 Paste" Classes="ghost"
                                Click="PasteButton_Click"/>
                        <Button Name="FetchButton" Grid.Column="2"
                                Content="🔍 Fetch Info" Classes="red"
                                Click="FetchButton_Click"/>
                    </Grid>

                    <!-- Search results (shown when the box holds search words) -->
                    <Border Name="SearchResultsPanel"
                            Background="{DynamicResource BgDarkBrush}"
                            CornerRadius="10" Padding="8"
                            IsVisible="False">
                        <StackPanel Spacing="6">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Name="SearchStatusText" Classes="label"
                                           VerticalAlignment="Center" TextWrapping="Wrap"
                                           Margin="6,0,0,0"/>
                                <Button Name="CloseResultsButton" Grid.Column="1"
                                        Content="✕" Classes="ghost" Padding="14,8"
                                        Click="CloseResultsButton_Click"/>
                            </Grid>
                            <ListBox Name="SearchResultsList" Classes="results"
                                     SelectionChanged="SearchResultsList_SelectionChanged">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="core:SearchResult">
                                        <StackPanel Margin="2,4">
                                            <TextBlock Text="{CompiledBinding Title}"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       FontSize="15" FontWeight="SemiBold"
                                                       TextWrapping="Wrap" MaxLines="2"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{CompiledBinding Details}" Classes="label"
                                                       Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </Border>

                    <!-- Video info -->
                    <Border Name="VideoInfoPanel"
                            Background="{DynamicResource BgDarkBrush}"
                            CornerRadius="10" Padding="12"
                            IsVisible="False">
                        <StackPanel Spacing="10">
                            <Image Name="ThumbnailImage"
                                   Height="180"
                                   Stretch="UniformToFill"/>
                            <TextBlock Name="VideoTitleText"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       FontSize="15" FontWeight="SemiBold"
                                       TextWrapping="Wrap"/>
                            <TextBlock Name="ChannelText" Classes="label"/>
                            <TextBlock Name="DurationText" Classes="label"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Options card -->
            <Border Classes="card">
                <StackPanel Spacing="12">
                    <TextBlock Text="Format" Classes="label"/>
                    <Grid ColumnDefinitions="*,12,*">
                        <RadioButton Name="VideoRadio" Grid.Column="0" Classes="format"
                                     GroupName="fmt" Content="🎬 Video (MP4)" IsChecked="True"/>
                        <RadioButton Name="AudioRadio" Grid.Column="2" Classes="format"
                                     GroupName="fmt" Content="🎵 Audio (M4A)"/>
                    </Grid>
                    <!-- iPhone only: finished videos go to the Photos app. -->
                    <Grid Name="PhotosRow" ColumnDefinitions="*,Auto">
                        <TextBlock Text="Save videos to Photos" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextPrimaryBrush}" FontSize="15"/>
                        <ToggleSwitch Name="PhotosToggle" Grid.Column="1"
                                      OnContent="" OffContent="" MinWidth="0">
                            <ToggleSwitch.Resources>
                                <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#FFFF0000"/>
                                <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="#FFCC0000"/>
                                <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="#FF990000"/>
                            </ToggleSwitch.Resources>
                        </ToggleSwitch>
                    </Grid>
                    <TextBlock Text="Custom filename (optional)" Classes="label" Margin="0,4,0,0"/>
                    <TextBox Name="FilenameTextBox" Classes="yt"/>
                </StackPanel>
            </Border>

            <!-- Download -->
            <Button Name="DownloadButton"
                    Content="⬇️  Download" Classes="red"
                    Margin="0,0,0,14"
                    Click="DownloadButton_Click"/>

            <Button Name="CancelButton"
                    Content="❌  Cancel" Classes="ghost"
                    HorizontalAlignment="Stretch"
                    Margin="0,0,0,14"
                    IsVisible="False"
                    Click="CancelButton_Click"/>

            <!-- Progress card -->
            <Border Classes="card">
                <StackPanel Spacing="10">
                    <ProgressBar Name="DownloadProgressBar" Classes="yt"
                                 Minimum="0" Maximum="100" Value="0"/>
                    <TextBlock Name="StatusText" Text="Ready"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               FontSize="14" TextWrapping="Wrap"/>
                    <TextBlock Name="HintText"
                               Text="Saved files appear in the Files app under &quot;YT Downloader&quot;."
                               Classes="label" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <TextBlock Text="Video up to 1080p (H.264) • video and audio merged on the phone, no ffmpeg"
                       Classes="label"
                       HorizontalAlignment="Center"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       Margin="0,4,0,0"/>

        </StackPanel>
    </ScrollViewer>
</UserControl>

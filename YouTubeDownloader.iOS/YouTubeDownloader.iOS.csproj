<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- The iOS 26.0 SDK, which Avalonia.iOS 12 is built against and every Xcode 26.x can
         build. Plain net10.0-ios follows the newest SDK in the installed workload, which can
         need a newer Xcode (the 27.0 workload wants Xcode 27). -->
    <TargetFramework>net10.0-ios26.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <SupportedOSPlatformVersion>13.0</SupportedOSPlatformVersion>
    <RootNamespace>YouTubeDownloader.iOS</RootNamespace>
    <AssemblyName>YouTubeDownloader.iOS</AssemblyName>

    <!-- Device builds (ios-arm64) full-AOT compile, so no JIT is needed at
         runtime; that is what makes a sideloaded build run on a stock iPhone.
         Release trims (the default: the .NET libraries plus libraries that declare
         themselves trimmable, such as YoutubeExplode), which keeps that AOT compile short. -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.3" />
    <PackageReference Include="Avalonia.iOS" Version="12.1.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.3" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.3" />
    <!-- SkiaSharp's native library. SkiaSharp 3.119 only pulls it in for net10.0-ios26.2 and
         newer; this app targets the iOS 26.0 SDK (see TargetFramework), so NuGet falls back
         to its plain net10.0 dependencies and the app has no libSkiaSharp. Keep the version
         equal to the SkiaSharp that Avalonia uses. See also UseIosSkiaSharp below. -->
    <PackageReference Include="SkiaSharp.NativeAssets.iOS" Version="3.119.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\YouTubeDownloader.Core\YouTubeDownloader.Core.csproj" />
  </ItemGroup>

  <!-- The same fallback picks SkiaSharp's desktop build (lib/net10.0), which imports
       "libSkiaSharp"; iOS needs the build that imports "@rpath/libSkiaSharp.framework/libSkiaSharp".
       Swap in the package's iOS build (lib/net9.0-ios18.0, which applies to this app). Without
       it the app dies at launch with DllNotFoundException: libSkiaSharp. -->
  <Target Name="UseIosSkiaSharp" AfterTargets="ResolvePackageAssets">
    <ItemGroup>
      <_DesktopSkiaSharp Include="@(RuntimeCopyLocalItems)"
                         Condition="'%(RuntimeCopyLocalItems.NuGetPackageId)' == 'SkiaSharp' And '%(Filename)%(Extension)' == 'SkiaSharp.dll'" />
      <RuntimeCopyLocalItems Remove="@(_DesktopSkiaSharp)" />
      <RuntimeCopyLocalItems Include="@(_DesktopSkiaSharp->'$(NuGetPackageRoot)skiasharp/%(NuGetPackageVersion)/lib/net9.0-ios18.0/SkiaSharp.dll')" />
    </ItemGroup>
    <Error Condition="'@(_DesktopSkiaSharp)' != '' And !Exists('$(NuGetPackageRoot)skiasharp/%(_DesktopSkiaSharp.NuGetPackageVersion)/lib/net9.0-ios18.0/SkiaSharp.dll')"
           Text="SkiaSharp %(_DesktopSkiaSharp.NuGetPackageVersion) has no lib/net9.0-ios18.0 build; update UseIosSkiaSharp." />
  </Target>

  <!-- Trim a copy of YoutubeExplode without duplicate type names. Version 6.6 merges its
       helper libraries (PowerKit, AngleSharp, polyfills) into its own DLL, and the merge
       leaves types with the same full name. The iOS trimmer's "Collect Unmarked Members"
       step runs before marking and records every type by assembly and full name, so the
       first repeat crashes it (MT2231), whatever is rooted. tools/DedupeTypeNames renames
       the repeats (it refuses to touch visible types) and the copy replaces the original in
       the publish list, the supported way to change the trimmer's inputs. The copy is only
       rewritten when YoutubeExplode or the tool changes, so an unchanged rebuild doesn't
       trim and AOT-compile everything again. -->
  <PropertyGroup>
    <_DedupeToolDir>$(MSBuildThisFileDirectory)../tools/DedupeTypeNames/</_DedupeToolDir>
    <_DotnetExe Condition="'$(DOTNET_HOST_PATH)' != ''">$(DOTNET_HOST_PATH)</_DotnetExe>
    <_DotnetExe Condition="'$(_DotnetExe)' == ''">dotnet</_DotnetExe>
    <!-- On macOS the tool's own build must not inherit the outer build's MSBuild paths. -->
    <_DedupeEnv Condition="$([MSBuild]::IsOSPlatform('OSX'))">env -u MSBuildExtensionsPath -u MSBuildSDKsPath -u MSBUILD_EXE_PATH </_DedupeEnv>
  </PropertyGroup>

  <Target Name="_FindYoutubeExplodeToDedupe">
    <!-- Set here, not in the project body: IntermediateOutputPath is only final in targets. -->
    <PropertyGroup>
      <_DedupedYoutubeExplode>$(MSBuildProjectDirectory)/$(IntermediateOutputPath)deduped/YoutubeExplode.dll</_DedupedYoutubeExplode>
    </PropertyGroup>
    <ItemGroup>
      <_YoutubeExplodeOriginal Include="@(ResolvedFileToPublish)"
                               Condition="'%(Filename)%(Extension)' == 'YoutubeExplode.dll'" />
    </ItemGroup>
  </Target>

  <Target Name="_DedupeYoutubeExplode"
          DependsOnTargets="_FindYoutubeExplodeToDedupe"
          Inputs="@(_YoutubeExplodeOriginal);$(_DedupeToolDir)Program.cs;$(_DedupeToolDir)DedupeTypeNames.csproj"
          Outputs="$(_DedupedYoutubeExplode)">
    <Exec Condition="'@(_YoutubeExplodeOriginal)' != ''"
          Command="$(_DedupeEnv)&quot;$(_DotnetExe)&quot; run --project &quot;$(_DedupeToolDir)DedupeTypeNames.csproj&quot; -c Release -- &quot;%(_YoutubeExplodeOriginal.FullPath)&quot; &quot;$(_DedupedYoutubeExplode)&quot;" />
  </Target>

  <Target Name="UseDedupedYoutubeExplode"
          BeforeTargets="_ComputeManagedAssemblyToLink"
          DependsOnTargets="_DedupeYoutubeExplode">
    <ItemGroup Condition="'@(_YoutubeExplodeOriginal)' != ''">
      <ResolvedFileToPublish Remove="@(_YoutubeExplodeOriginal)" />
      <ResolvedFileToPublish Include="@(_YoutubeExplodeOriginal->'$(_DedupedYoutubeExplode)')" />
    </ItemGroup>
  </Target>

</Project>

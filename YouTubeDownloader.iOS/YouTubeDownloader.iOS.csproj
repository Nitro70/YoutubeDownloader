<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- The iOS 26.0 SDK, which Avalonia.iOS 12 is built against and every Xcode 26.x can
         build. Plain net10.0-ios follows the newest SDK in the installed workload, which can
         need a newer Xcode (the 27.0 workload wants Xcode 27). -->
    <TargetFramework>net10.0-ios26.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <SupportedOSPlatformVersion>13.0</SupportedOSPlatformVersion>
    <RootNamespace>YouTubeDownloader.iOS</RootNamespace>
    <AssemblyName>YouTubeDownloader.iOS</AssemblyName>

    <!-- Device builds (ios-arm64) full-AOT compile, so no JIT is needed at
         runtime; that is what makes a sideloaded build run on a stock iPhone.
         Release trims (the default), which is what keeps that AOT compile short. -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.3" />
    <PackageReference Include="Avalonia.iOS" Version="12.1.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.3" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\YouTubeDownloader.Core\YouTubeDownloader.Core.csproj" />
  </ItemGroup>

  <!-- Trim a copy of YoutubeExplode without duplicate type names. Version 6.6 merges its
       helper libraries (PowerKit, AngleSharp, polyfills) into its own DLL, and the merge
       leaves types with the same full name. The iOS trimmer's "Collect Unmarked Members"
       step runs before marking and records every type by assembly and full name, so the
       first repeat crashes it (MT2231), whatever is rooted. tools/DedupeTypeNames renames
       the repeats (all internal or compiler-generated) and the copy replaces the original
       in the publish list, the supported way to change the trimmer's inputs. -->
  <PropertyGroup>
    <_DedupeToolProject>$(MSBuildThisFileDirectory)../tools/DedupeTypeNames/DedupeTypeNames.csproj</_DedupeToolProject>
    <_DedupeTool>$(MSBuildThisFileDirectory)../tools/DedupeTypeNames/bin/Release/net10.0/DedupeTypeNames.dll</_DedupeTool>
    <_DedupedYoutubeExplode>$(MSBuildProjectDirectory)/$(IntermediateOutputPath)deduped/YoutubeExplode.dll</_DedupedYoutubeExplode>
    <_DotnetExe Condition="'$(DOTNET_HOST_PATH)' != ''">$(DOTNET_HOST_PATH)</_DotnetExe>
    <_DotnetExe Condition="'$(_DotnetExe)' == ''">dotnet</_DotnetExe>
  </PropertyGroup>

  <Target Name="TrimDedupedYoutubeExplode" BeforeTargets="_ComputeManagedAssemblyToLink">
    <ItemGroup>
      <_YoutubeExplodeOriginal Include="@(ResolvedFileToPublish)"
                               Condition="'%(Filename)%(Extension)' == 'YoutubeExplode.dll'" />
    </ItemGroup>
    <!-- A separate build of the tool: clear the variables the outer build sets for itself. -->
    <Exec Condition="'@(_YoutubeExplodeOriginal)' != ''"
          Command="env -u MSBuildExtensionsPath -u MSBuildSDKsPath -u MSBUILD_EXE_PATH &quot;$(_DotnetExe)&quot; build &quot;$(_DedupeToolProject)&quot; -c Release -nologo -v:q" />
    <Exec Condition="'@(_YoutubeExplodeOriginal)' != ''"
          Command="&quot;$(_DotnetExe)&quot; &quot;$(_DedupeTool)&quot; &quot;%(_YoutubeExplodeOriginal.FullPath)&quot; &quot;$(_DedupedYoutubeExplode)&quot;" />
    <ItemGroup Condition="'@(_YoutubeExplodeOriginal)' != ''">
      <ResolvedFileToPublish Remove="@(_YoutubeExplodeOriginal)" />
      <ResolvedFileToPublish Include="@(_YoutubeExplodeOriginal->'$(_DedupedYoutubeExplode)')" />
    </ItemGroup>
  </Target>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- The iOS 26.0 SDK, which Avalonia.iOS 12 is built against and every Xcode 26.x can
         build. Plain net10.0-ios follows the newest SDK in the installed workload, which can
         need a newer Xcode (the 27.0 workload wants Xcode 27). -->
    <TargetFramework>net10.0-ios26.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <SupportedOSPlatformVersion>13.0</SupportedOSPlatformVersion>
    <RootNamespace>YouTubeDownloader.iOS</RootNamespace>
    <AssemblyName>YouTubeDownloader.iOS</AssemblyName>

    <!-- Device builds (ios-arm64) full-AOT compile, so no JIT is needed at
         runtime; that is what makes a sideloaded build run on a stock iPhone.
         Release trims (the default), which is what keeps that AOT compile short. -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.3" />
    <PackageReference Include="Avalonia.iOS" Version="12.1.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.3" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\YouTubeDownloader.Core\YouTubeDownloader.Core.csproj" />
  </ItemGroup>

  <!-- Keep all of YoutubeExplode. Version 6.6 bundles its helper libraries (PowerKit,
       polyfills) into its own DLL and the result has types with duplicate names. The iOS
       trimmer's "Collect Unmarked Members" step records every type it removes by assembly
       and name, so removing two same-named types crashes it (MT2231). Kept whole, none of
       its types are removed; everything else is still trimmed. -->
  <ItemGroup>
    <TrimmerRootAssembly Include="YoutubeExplode" />
  </ItemGroup>

</Project>

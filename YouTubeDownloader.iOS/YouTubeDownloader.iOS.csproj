<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-ios</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <SupportedOSPlatformVersion>13.0</SupportedOSPlatformVersion>
    <RootNamespace>YouTubeDownloader.iOS</RootNamespace>
    <AssemblyName>YouTubeDownloader.iOS</AssemblyName>

    <!-- Device builds (ios-arm64) full-AOT compile, so no JIT is needed at
         runtime; that is what makes a sideloaded build run on a stock iPhone.
         No trimming (None, not SdkOnly): YoutubeExplode 6.6+ ships C# extension-member
         polyfills that crash the .NET 8 iOS linker's "Collect Unmarked Members" step,
         which only runs when something is trimmed. Costs IPA size, not behaviour. -->
    <MtouchLink Condition="'$(Configuration)' == 'Release'">None</MtouchLink>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.2.3" />
    <PackageReference Include="Avalonia.iOS" Version="11.2.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.3" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.2.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\YouTubeDownloader.Core\YouTubeDownloader.Core.csproj" />
  </ItemGroup>

</Project>

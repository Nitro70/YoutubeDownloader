<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>YouTubeDownloader</AssemblyName>
    <RootNamespace>YouTubeDownloader</RootNamespace>
    <Version>3.5.0</Version>
    <Authors>YouTubeDownloader</Authors>
    <Description>A cross-platform YouTube video downloader</Description>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>

    <!-- Single-file publish settings -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.3" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.3" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.3" />
    <PackageReference Include="MessageBox.Avalonia" Version="12.0.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" Condition="Exists('Assets')" />
  </ItemGroup>

  <!-- Shared Core library: YouTube search (also used by the phone apps). -->
  <ItemGroup>
    <ProjectReference Include="..\YouTubeDownloader.Core\YouTubeDownloader.Core.csproj" />
  </ItemGroup>

  <!-- Per-RID embedded tools. The Tools\ folder layout is:
         Tools\win-x64\   yt-dlp.exe, ffmpeg.exe, ffprobe.exe, *.dll
         Tools\linux-x64\ yt-dlp, ffmpeg, ffprobe
       We embed every file that matches the publish RID (a glob, so we don't
       break when the ffmpeg build bumps a DLL's version-numbered name), and
       only for the target platform so each single-file build carries one
       toolchain. ToolsExtractor extracts whatever is embedded. -->
  <ItemGroup Condition="'$(RuntimeIdentifier)' == 'win-x64' Or '$(RuntimeIdentifier)' == ''">
    <EmbeddedResource Include="Tools\win-x64\*">
      <LogicalName>YouTubeDownloader.Tools.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup Condition="'$(RuntimeIdentifier)' == 'linux-x64'">
    <EmbeddedResource Include="Tools\linux-x64\*">
      <LogicalName>YouTubeDownloader.Tools.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>

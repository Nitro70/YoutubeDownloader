<Window x:Class="YouTubeDownloader.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="YouTube Downloader"
        Height="750" Width="950"
        MinHeight="650" MinWidth="850"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgDarkBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="40"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource BgSecondaryBrush}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0">
                <TextBlock Text="▶" FontSize="28" FontWeight="Bold"
                           Foreground="{StaticResource RedBrush}"
                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Text="YouTube Downloader"
                           Style="{StaticResource HeaderText}"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Main Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20">
            <StackPanel>

                <!-- URL Input Section -->
                <Border Style="{StaticResource CardPanel}">
                    <StackPanel>
                        <TextBlock Text="Video URL" Style="{StaticResource SectionTitle}"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0">
                                <TextBox x:Name="UrlTextBox"
                                         Style="{StaticResource YouTubeTextBox}"
                                         Height="50"
                                         VerticalContentAlignment="Center"
                                         KeyDown="UrlTextBox_KeyDown"
                                         TextChanged="UrlTextBox_TextChanged"/>
                                <TextBlock x:Name="UrlPlaceholder"
                                           Text="Paste a YouTube URL here, then press Enter"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           VerticalAlignment="Center"
                                           Margin="16,0,0,0"
                                           IsHitTestVisible="False"/>
                            </Grid>

                            <Button x:Name="PasteButton"
                                    Grid.Column="1"
                                    Content="📋 Paste"
                                    Style="{StaticResource YouTubeButton}"
                                    Margin="10,0,0,0"
                                    Height="50"
                                    Click="PasteButton_Click"/>

                            <Button x:Name="FetchInfoButton"
                                    Grid.Column="2"
                                    Content="🔍 Fetch Info"
                                    Style="{StaticResource YouTubeRedButton}"
                                    Margin="10,0,0,0"
                                    Height="50"
                                    Click="FetchInfoButton_Click"/>
                        </Grid>

                        <!-- Video Info Display -->
                        <Border x:Name="VideoInfoPanel"
                                Background="{StaticResource BgDarkBrush}"
                                CornerRadius="8"
                                Margin="0,15,0,0"
                                Padding="15"
                                Visibility="Collapsed">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Image x:Name="ThumbnailImage"
                                       Grid.Column="0"
                                       Width="160" Height="90"
                                       Stretch="UniformToFill"
                                       Margin="0,0,15,0"/>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="VideoTitleText"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               FontSize="14" FontWeight="SemiBold"
                                               TextWrapping="Wrap"
                                               MaxHeight="40"/>
                                    <TextBlock x:Name="ChannelText"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               FontSize="12"
                                               Margin="0,5,0,0"/>
                                    <TextBlock x:Name="DurationText"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               FontSize="12"
                                               Margin="0,3,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Download Options Section -->
                <Border Style="{StaticResource CardPanel}">
                    <StackPanel>
                        <TextBlock Text="Download Options" Style="{StaticResource SectionTitle}"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="40"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>

                            <!-- Format Selection -->
                            <StackPanel Grid.Column="0" Grid.Row="0">
                                <TextBlock Text="Format" Style="{StaticResource LabelText}" Margin="0,0,0,8"/>
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="Mp4Radio"
                                                 Content="🎬 MP4 (Video)"
                                                 Style="{StaticResource FormatRadioButton}"
                                                 IsChecked="True"
                                                 Checked="FormatRadio_Changed"/>
                                    <RadioButton x:Name="Mp3Radio"
                                                 Content="🎵 MP3 (Audio)"
                                                 Style="{StaticResource FormatRadioButton}"
                                                 Checked="FormatRadio_Changed"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Quality Selection -->
                            <StackPanel Grid.Column="2" Grid.Row="0">
                                <TextBlock Text="Quality" Style="{StaticResource LabelText}" Margin="0,0,0,8"/>
                                <ComboBox x:Name="QualityComboBox"
                                          Width="150" Height="44"
                                          Style="{StaticResource YouTubeComboBox}">
                                    <ComboBoxItem Content="Best" IsSelected="True"/>
                                    <ComboBoxItem Content="1080p"/>
                                    <ComboBoxItem Content="720p"/>
                                    <ComboBoxItem Content="480p"/>
                                    <ComboBoxItem Content="360p"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <!-- Filename -->
                        <StackPanel Margin="0,20,0,0">
                            <TextBlock Text="Custom Filename (optional - leave empty for original title)"
                                       Style="{StaticResource LabelText}" Margin="0,0,0,8"/>
                            <TextBox x:Name="FilenameTextBox"
                                     Style="{StaticResource YouTubeTextBox}"
                                     Height="48"/>
                        </StackPanel>

                        <!-- Output Directory -->
                        <StackPanel Margin="0,15,0,0">
                            <TextBlock Text="Save Location"
                                       Style="{StaticResource LabelText}" Margin="0,0,0,8"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBox x:Name="OutputDirTextBox"
                                         Grid.Column="0"
                                         Style="{StaticResource YouTubeTextBox}"
                                         Height="48"
                                         IsReadOnly="True"/>

                                <Button x:Name="BrowseButton"
                                        Grid.Column="1"
                                        Content="📁 Browse"
                                        Style="{StaticResource YouTubeButton}"
                                        Margin="10,0,0,0"
                                        Height="48"
                                        Click="BrowseButton_Click"/>

                                <Button x:Name="OpenFolderButton"
                                        Grid.Column="2"
                                        Content="📂 Open"
                                        Style="{StaticResource YouTubeButton}"
                                        Margin="10,0,0,0"
                                        Height="48"
                                        Click="OpenFolderButton_Click"/>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Download Buttons -->
                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="DownloadButton"
                            Grid.Column="0"
                            Content="⬇️  Download Video"
                            Style="{StaticResource YouTubeRedButton}"
                            Height="55"
                            FontSize="16"
                            Click="DownloadButton_Click"/>

                    <Button x:Name="ChannelDownloadButton"
                            Grid.Column="2"
                            Content="📺  Download Entire Channel"
                            Style="{StaticResource YouTubeOutlineButton}"
                            Height="55"
                            FontSize="16"
                            Click="ChannelDownloadButton_Click"/>
                </Grid>

                <!-- Cancel Button (hidden by default) -->
                <Button x:Name="CancelButton"
                        Content="❌  Cancel Download"
                        Style="{StaticResource YouTubeRedButton}"
                        Height="55"
                        FontSize="16"
                        Margin="0,0,0,15"
                        Visibility="Collapsed"
                        Click="CancelButton_Click"/>

                <!-- Progress Section -->
                <Border Style="{StaticResource CardPanel}">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <TextBlock Text="Download Progress" Style="{StaticResource SectionTitle}"
                                       HorizontalAlignment="Left" Margin="0"/>
                            <Button x:Name="ShowInFolderButton"
                                    Content="📂 Show in Folder"
                                    Style="{StaticResource YouTubeButton}"
                                    HorizontalAlignment="Right"
                                    Padding="12,6"
                                    FontSize="12"
                                    Visibility="Collapsed"
                                    Click="OpenFolderButton_Click"/>
                        </Grid>

                        <ProgressBar x:Name="DownloadProgressBar"
                                     Style="{StaticResource YouTubeProgressBar}"
                                     Minimum="0" Maximum="100" Value="0"
                                     Margin="0,0,0,8"/>

                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock x:Name="ProgressText"
                                       Grid.Column="0"
                                       Text="Ready to download"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       FontSize="13"
                                       VerticalAlignment="Center"/>

                            <TextBlock x:Name="ProgressStatsText"
                                       Grid.Column="1"
                                       Text=""
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="12"
                                       VerticalAlignment="Center"/>
                        </Grid>

                        <Border Background="{StaticResource BgDarkBrush}"
                                CornerRadius="4"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                Height="180">
                            <ListBox x:Name="LogListBox"
                                     Style="{StaticResource LogListBox}"
                                     BorderThickness="0"
                                     HorizontalContentAlignment="Stretch"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="2" Background="{StaticResource BgSecondaryBrush}">
            <TextBlock Text="Powered by yt-dlp &amp; FFmpeg  •  YouTube Downloader v1.0"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       FontSize="11"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
        </Border>

    </Grid>
</Window>
